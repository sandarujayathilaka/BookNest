<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:gravity="center"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/relative_layout_border">
        <ImageView
            android:id="@+id/ivUsernameIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_marginStart="8dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_username"
            android:contentDescription="Username Icon"
            android:padding="4dp" />

        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/ivUsernameIcon"
            android:hint="Username"
            android:inputType="text"
            android:padding="12dp"
            android:background="@null"/>
    </RelativeLayout>

    <!-- Password Field with Visibility Toggle Icon -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/relative_layout_border">

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password"
            android:inputType="textPassword"
            android:padding="12dp"
            android:background="@null"
            android:layout_toStartOf="@id/ivTogglePasswordVisibility"/>

        <ImageView
            android:id="@+id/ivTogglePasswordVisibility"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_visibility_off"
            android:contentDescription="Toggle password visibility"
            android:padding="4dp"
            android:layout_marginStart="8dp"/>
    </RelativeLayout>


    <!-- Login Button -->
    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Login"
        android:padding="12dp"
        android:background="@color/colorPrimary"
        android:textColor="@android:color/white"
        android:layout_marginTop="16dp" />

    <!-- Forgot Password Hyperlink -->
    <TextView
        android:id="@+id/tvForgotPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Forgot Password? Click here"
        android:textColor="@color/colorAccent"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:clickable="true"
        android:textSize="16sp"
        android:onClick="onForgotPasswordClick" />
</LinearLayout>